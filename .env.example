# ─────────────────────────────────────────────────────────────────────────────
# Environment Variables Example for Salama Web Portfolio
# ─────────────────────────────────────────────────────────────────────────────
# Set these in your local .env or in Vercel Project Settings -> Environment Variables.
# In Vite / React Router, client-accessible variables must start with VITE_.

# Contact Form Submission Endpoint
# Supports Formspree (e.g. https://formspree.io/f/{form_id}), Getform, Basin, or custom webhook
VITE_CONTACT_ENDPOINT=https://formspree.io/f/your_form_id

# Optional alias for Formspree
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id

